# Example environment variables for QuanLyThuVien
# Copy this file to `.env` and fill actual values for local development.

DB_SERVER=localhost\SQLEXPRESS
DB_USER=your_db_user
DB_PASSWORD=your_db_password_here
DB_DATABASE=quanlythuvien
JWT_SECRET=replace_with_secure_random_string
PORT=5000

# Notes:
# - Do NOT commit a real `.env` with secrets.
# - Adjust DB_SERVER to your SQL Server instance name (e.g. MACHINE\\SQLEXPRESS).